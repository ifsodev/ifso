{
  "name": "@ifso/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IFSO conditional money on Robinhood Chain: API, Telegram bot, keepers, outcome resolver, indexer, notifier",
  "scripts": {
    "api": "bun run src/main.ts api",
    "bot": "bun run src/main.ts bot",
    "worker": "bun run src/main.ts worker",
    "all": "bun run src/main.ts all",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "abi": "node ../contracts/tools/solcjs-compile.mjs --src-only --abi-out ./abi-json",
    "build:client": "bun build src/client/index.ts --outdir dist/client --target browser --format esm --external viem"
  },
  "dependencies": {
    "@hono/trpc-server": "0.3.4",
    "@trpc/server": "11.8.0",
    "bullmq": "5.56.0",
    "drizzle-orm": "0.45.2",
    "grammy": "1.37.0",
    "hono": "4.13.14",
    "ioredis": "5.6.1",
    "postgres": "3.4.7",
    "viem": "2.57.11",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.2.18",
    "drizzle-kit": "0.31.4",
    "typescript": "5.8.3"
  },
  "exports": {
    "./client": "./src/client/index.ts"
  }
}
