# --- runtime
NODE_ENV=development
PORT=8080
PUBLIC_APP_URL=https://ifso.tech
# extra browser origins allowed to call the API (comma separated); PUBLIC_APP_URL is always allowed
WEB_ORIGINS=
CHAIN_ID=4663
# tried in this order
RHC_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood.daybreak-rpc.network
DATABASE_URL=postgres://ifso:ifso@localhost:5442/ifso
REDIS_URL=redis://localhost:6389

# --- contracts (from script/Deploy.s.sol output)
ESCROW_ADDRESS=
EVALUATOR_ADDRESS=
RESOLVER_ADDRESS=
# optional: lets the admin-event monitor also watch the fee router
FEE_ROUTER_ADDRESS=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ESCROW_DEPLOY_BLOCK=0
# the indexer trails the head by this many blocks
CONFIRMATIONS=3
# 1: keeper and price watcher log each decision next to the eth_call answer and send nothing
KEEPER_SHADOW=

# --- hot keys: three SEPARATE fresh keys as encrypted keystores (JSON v3) + a password file each; small ETH only
# (the resolver also holds USDG for bonds). Raw *_PK is accepted only on a local chain (CHAIN_ID=31337).
RELAYER_KEYSTORE=
RELAYER_PASSWORD_FILE=
KEEPER_KEYSTORE=
KEEPER_PASSWORD_FILE=
RESOLVER_KEYSTORE=
RESOLVER_PASSWORD_FILE=

# --- ops alerts (Telegram ops chat); log-only unless ALERTS_ARMED=1
OPS_CHAT_ID=
ALERTS_ARMED=0
# oracle staleness: feed older than its heartbeat plus this margin (stock feeds count US market hours only)
ORACLE_STALE_MARGIN_SECONDS=3600
# large outflow from the escrow: total per window, and any single transfer above LARGE_RELEASE_USDG (launch cap 1,000)
OUTFLOW_WINDOW_MINUTES=60
OUTFLOW_WINDOW_USDG=5000
LARGE_RELEASE_USDG=1000
IP_HASH_SALT=

# --- Telegram (plain bot, no Mini App). With a webhook secret the API serves POST /tg/<secret path> and checks the
# X-Telegram-Bot-Api-Secret-Token header; without one, `bun run bot` long-polls (local dev). Blank lines count as unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- outcome sources (>= 2 must agree before any proposal)
ODDS_API_KEY=
SECOND_SPORTS_SOURCE=thesportsdb
THESPORTSDB_KEY=123
POLYGON_RPC_URL=https://polygon-bor.publicnode.com
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# --- account abstraction for wallet-less recipients (spend after claim)
ZERODEV_PROJECT_ID=
ALCHEMY_KEY=

# --- abuse limits
# Which single hop in front of the API is trusted for the client address and country:
#   none (default) socket address only, country unknown (Stock Token conditions stay blocked)
#   cloudflare     cf-connecting-ip + cf-ipcountry (the origin must only accept Cloudflare)
#   vercel         x-real-ip (else last x-forwarded-for entry) + x-vercel-ip-country
#   caddy          the LAST x-forwarded-for entry (the address Caddy appended); no country header
# The first x-forwarded-for entry and x-country are never trusted. IPv6 is limited per /64.
TRUST_PROXY=none
CLAIM_RELAY_PER_IP_PER_HOUR=20
# relayed calls we pay gas for (create, accept, decision, refund redirect)
RELAY_PER_IP_PER_HOUR=60
RELAY_PER_SIGNER_PER_HOUR=20
RELAY_PER_ESCROW_PER_DAY=10
# new outcome questions a caller may plan through build
BUILD_QUESTIONS_PER_IP_PER_HOUR=10
BUILD_QUESTIONS_PER_SENDER_PER_HOUR=5
# Polymarket allow-list for outcome payments
POLYMARKET_MIN_LIQUIDITY_USD=5000
POLYMARKET_MIN_VOLUME_USD=25000
POLYMARKET_MAX_DAYS_OUT=60
SPONSOR_MIN_AMOUNT_USDG=1
# $IFSO holder perks, enforced on the server. Leave the token address empty until the token exists (every perk shows locked).
IFSO_TOKEN_ADDRESS=
IFSO_TOKEN_DECIMALS=18
HOLDER_MIN_IFSO=100000
WHALE_MIN_IFSO=1000000
PERKS_CACHE_SECONDS=30
# Our own wallets (relayer, keeper, resolver, deployer, test wallets), comma separated: excluded from /stats/users
INTERNAL_ADDRESSES=
