# --- runtime
NODE_ENV=development
PORT=8080
PUBLIC_APP_URL=https://ifso.app
CHAIN_ID=4663
RHC_RPC_URL=https://api-robinhood-mainnet-archive.n.dwellir.com/YOUR_KEY   # public RPC is rate-limited
DATABASE_URL=postgres://ifso:ifso@localhost:5432/ifso
REDIS_URL=redis://localhost:6379

# --- contracts (from script/Deploy.s.sol output)
ESCROW_ADDRESS=
EVALUATOR_ADDRESS=
RESOLVER_ADDRESS=
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ESCROW_DEPLOY_BLOCK=0

# --- hot keys: three SEPARATE fresh keys, small ETH balances only (resolver also holds USDG for bonds)
RELAYER_PK=
KEEPER_PK=
RESOLVER_PK=

# --- Telegram (plain bot, no Mini App)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- outcome sources (>= 2 must agree before any proposal)
ODDS_API_KEY=
SECOND_SPORTS_SOURCE=thesportsdb
THESPORTSDB_KEY=3
POLYGON_RPC_URL=
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

# --- account abstraction for wallet-less recipients (spend after claim)
ZERODEV_PROJECT_ID=
ALCHEMY_KEY=

# --- abuse limits
CLAIM_RELAY_PER_IP_PER_HOUR=20
SPONSOR_MIN_AMOUNT_USDG=1
