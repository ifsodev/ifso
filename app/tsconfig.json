{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "test", "drizzle.config.ts"]
}
