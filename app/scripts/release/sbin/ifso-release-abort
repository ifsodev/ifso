#!/usr/bin/env bash
# Root-owned; ifso-ops via sudo. abort: see lib/release.py (abort). Never touches production directly.
LIB="${IFSO_RELEASE_LIB:-/usr/local/lib/ifso-release}"
[[ -n "${SUDO_UID:-}" ]] && LIB=/usr/local/lib/ifso-release
# shellcheck disable=SC1091
. "$LIB/common.sh"
[[ $# == 0 ]] || die "no arguments"
release_py abort
