# /etc/caddy/sites/ifso.caddy, EDGE=cloudflare variant (provision.sh --cohost with EDGE=cloudflare). Cloudflare proxies the
# API (orange cloud); the API runs with TRUST_PROXY=cloudflare and reads cf-connecting-ip / cf-ipcountry.
# Those headers are only true when the request really came through Cloudflare, so this site answers Cloudflare's address
# ranges only and drops every other connection (someone hitting the server's IP directly cannot forge a country).
# Ranges from https://www.cloudflare.com/ips-v4/ and /ips-v6/ (2026-11-01); refresh them with the provision script's
# --caddy-only when Cloudflare publishes changes. ACME HTTP-01 challenges are answered by Caddy before these routes.
# No access-log file on purpose: a log path Caddy cannot write would fail a reload that also carries the other sites.

@DOMAIN@ {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare

	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy 127.0.0.1:3201
}
