# Ifso worker role (keeper, price watcher, resolver, indexer, notifier; run exactly one). Installed to /etc/systemd/system by provision.sh; started and stopped with ifso.target.
# Secrets come only from the root-owned env files (mode 0600, read by systemd as root); nothing is on a command line.
[Unit]
Description=Ifso worker (keeper, price watcher, resolver, indexer, notifier; run exactly one)
Documentation=file:/opt/ifso/current/app/scripts/server/README.md
PartOf=ifso.target
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Its own Unix user (review R2-L3): only this role's key files are readable by it.
User=ifso-worker
Group=ifso-worker
WorkingDirectory=/opt/ifso/current/app
Environment=HOME=/var/lib/ifso-worker
StateDirectory=ifso-worker
StateDirectoryMode=0700
EnvironmentFile=/etc/ifso/common.env
EnvironmentFile=/etc/ifso/db.env
EnvironmentFile=/etc/ifso/worker.env
ExecStart=/usr/local/bin/bun src/main.ts worker
Restart=always
RestartSec=10
TimeoutStopSec=30
MemoryMax=768M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ifso-worker
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
# Defence in depth on top of the file owners: the other roles' keys do not exist in this unit's view.
InaccessiblePaths=-/etc/ifso/keys/relayer.json -/etc/ifso/keys/relayer.password
UMask=0077
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=ifso.target
