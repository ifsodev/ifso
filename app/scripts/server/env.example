# Ifso server settings. provision.sh splits this file on the "[section: ...]" lines into /etc/ifso/common.env,
# /etc/ifso/api.env and /etc/ifso/worker.env (the bot role reads common.env plus an optional /etc/ifso/bot.env). Every file is
# written once, mode 0600, owned by root; systemd reads them. Later runs never overwrite them.
#
# Rules: CHANGE_ME must be replaced before deploy.sh will run. A line with no value (KEY=) means "not set": the app then uses
# its own default or, for optional settings, leaves the feature off. NEVER paste a secret into a chat, a ticket or git.
# DATABASE_URL and REDIS_URL are NOT here: provision.sh writes them (with random passwords) to /etc/ifso/db.env.
# RELAYER_PK, KEEPER_PK and RESOLVER_PK (raw keys) are for a local anvil only and must never be used on a server.
# Which role needs what comes from app/src/config/env.ts; the role is named after each variable.

# [section: common]
# --- every role (api, bot, worker)
NODE_ENV=production
# 46630 = testnet, 4663 = mainnet. deploy.sh refuses a profile/chain mismatch.
CHAIN_ID=CHANGE_ME
# Comma separated, tried in this order. Free public endpoints only. Blank = the app default (mainnet endpoints).
RHC_RPC_URLS=
RHC_WS_URL=
# Contract addresses from the deployment (not secrets). The escrow is needed by api, bot and worker.
ESCROW_ADDRESS=CHANGE_ME
EVALUATOR_ADDRESS=
USDG_ADDRESS=
ESCROW_DEPLOY_BLOCK=0
# The indexer trails the head by this many blocks.
CONFIRMATIONS=3
PUBLIC_APP_URL=
# "1" = the keeper and price watcher only log what they would do and never send (use on a first testnet run).
KEEPER_SHADOW=
# Telegram: the bot token is a SECRET. Needed by the bot role; the api and worker use it to answer and notify.
# Leave blank to run without Telegram (deploy.sh then skips ifso-bot).
TELEGRAM_BOT_TOKEN=
# Ops alerts to the team's Telegram ops chat. Log-only until ALERTS_ARMED=1. OPS_BOT_TOKEN is a SECRET (blank = use the bot token).
OPS_CHAT_ID=
OPS_BOT_TOKEN=
ALERTS_ARMED=
MIN_RELAYER_ETH=
MIN_KEEPER_ETH=
MIN_RESOLVER_ETH=
MIN_RESOLVER_USDG=

# [section: api]
# --- api role only (written to /etc/ifso/api.env)
# Caddy forwards to this port on 127.0.0.1. Keep it: the Caddyfile and deploy.sh use 8080.
PORT=8080
# Listen on loopback only: Caddy on the same host is the only client (ufw is the second fence, not the first).
HOST=127.0.0.1
# The API sits behind Caddy, which replaces X-Forwarded-For with the real client address. With "none" every request
# would come from 127.0.0.1 and all users would share one rate-limit bucket. Required in production (deploy.sh refuses).
TRUST_PROXY=caddy
# Browser origins allowed to call the API (CORS), comma separated, e.g. https://<your-site>,https://www.<your-site>.
# PUBLIC_APP_URL is always allowed. Empty = only PUBLIC_APP_URL (deploy.sh warns about it in production).
WEB_ORIGINS=
# Secret salt for stored IP hashes. provision.sh fills this in with random bytes on the first run.
IP_HASH_SALT=CHANGE_ME
# Telegram webhook (alternative to the ifso-bot long polling; use one of the two, never both).
TELEGRAM_WEBHOOK_SECRET=
# Relayer hot key: submits claims and decisions (pays gas, cannot redirect funds). Encrypted keystore + password file.
RELAYER_KEYSTORE=/etc/ifso/keys/relayer.json
RELAYER_PASSWORD_FILE=/etc/ifso/keys/relayer.password
CLAIM_RELAY_PER_IP_PER_HOUR=
SPONSOR_MIN_AMOUNT_USDG=
# Optional hosted-service keys (SECRETS). Blank = off.
ZERODEV_PROJECT_ID=
ALCHEMY_KEY=

# [section: worker]
# --- worker role only (written to /etc/ifso/worker.env). Run exactly one worker per database.
# The resolver contract address (not a secret).
RESOLVER_ADDRESS=CHANGE_ME
# Keeper hot key: settle and refund sweeps.
KEEPER_KEYSTORE=/etc/ifso/keys/keeper.json
KEEPER_PASSWORD_FILE=/etc/ifso/keys/keeper.password
# Resolver hot key: registers questions and proposes outcomes (holds USDG for bonds).
RESOLVER_KEYSTORE=/etc/ifso/keys/resolver.json
RESOLVER_PASSWORD_FILE=/etc/ifso/keys/resolver.password
# Outcome sources. ODDS_API_KEY is a SECRET (blank = that source off). The others have free defaults.
ODDS_API_KEY=
SECOND_SPORTS_SOURCE=
THESPORTSDB_KEY=
POLYGON_RPC_URL=
PYTH_HERMES_URL=
PYTH_API_KEY=
