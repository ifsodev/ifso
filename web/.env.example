# Everything the site needs comes from NEXT_PUBLIC_* variables (inlined at build time) and the deployments file for the
# chosen chain (src/config/deployments/<chain id>.json). Nothing here is a secret.

# Origin of the IFSO API, no trailing slash. The browser calls it directly.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# 4663 Robinhood Chain, 46630 testnet, 31337 local fork
NEXT_PUBLIC_CHAIN_ID=4663
# Optional overrides; each chain has a public default
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Optional: take the contract addresses from here instead of the deployments file. The API's /healthz must agree.
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
# Reown project id (free). With it the dashboard's wallet picker is WalletConnect; without it, the wallets the browser
# announces. Never loaded on the claim page or /link.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Canonical site origin (SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
